# Local development defaults to demo; VERCEL_ENV=production defaults to live.
# Set APP_MODE explicitly to avoid ambiguity. Secrets must NOT be NEXT_PUBLIC.
APP_MODE=demo
NEXT_PUBLIC_BRAND_NAME=Numora SMS

# LIVE MODE: canonical HTTPS origin, random secret >=32 chars, scrypt password hash.
APP_URL=
AUTH_SECRET=
OPERATOR_PASSWORD_HASH=

# Paid Twilio number provisioning and authenticated inbound history.
# Use a dedicated subaccount and standard API key owned by that subaccount.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Required only when accepting Twilio-signed webhooks; never an API key secret.
TWILIO_AUTH_TOKEN=
LIVE_PURCHASE_ENABLED=false

# TextBee optional personal Android phone + active SIM (not rental inventory).
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_WEBHOOK_SECRET=

# Webhooks optional: polling works without Supabase.
LIVE_WEBHOOKS_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy placeholders, not consumed by the implemented adapters.
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_WEBHOOK_SECRET=
